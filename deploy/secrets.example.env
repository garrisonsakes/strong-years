# Strong Years secrets, grouped by who issues them. Copy to deploy/secrets.env (gitignored) or, better, keep them in
# 1Password and render this file at deploy time. Every value is empty here on purpose. `make check-secrets` validates
# a filled copy (required keys present, no placeholders, minimum lengths) and that no secrets file is tracked by git.
# R = required for the stack to start · L = required before launch · O = optional / later.

# --- Generated by us (openssl rand -base64 48) -------------------------------------------------------------
WORKER_TOKEN=                 # R  n8n and the members app → workers (X-Worker-Token); 40+ chars
EXCEPTIONS_API_TOKEN=         # R  workers → members app POST /api/exceptions (Bearer); 40+ chars
GROWTH_API_TOKEN=             # R  workers growth → members app GET /api/growth/posts; 40+ chars
CRON_SECRET=                  # R  Vercel Cron → /api/cron/* (Bearer); 32+ chars
SESSION_SECRET=               # R  members app session + unsubscribe link signatures; 32+ chars
N8N_ENCRYPTION_KEY=           # R  encrypts n8n credentials at rest; never rotate without re-entering credentials
N8N_DB_PASSWORD=              # R  n8n's Postgres
REDIS_PASSWORD=               # R  n8n queue (Bull) on Redis
DM_VERIFY_TOKEN=              # L  Meta webhook subscription check for /dm/webhook
ADMIN_PASSWORD=               # R  members app /admin basic auth (with ADMIN_USER)
ADMIN_TOTP_SECRET=            # L  second factor for /admin (base32)
VAPID_PRIVATE_KEY=            # L  web push (npx web-push generate-vapid-keys; the public key is not secret)

# --- Supabase (two projects: members app, content pipeline) ---------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=    # R  members app server-side DB access (bypasses RLS; never in the browser)
APP_DATABASE_URL=             # R  members app Postgres URL for make db-migrate (Settings → Database → URI)
PIPELINE_SUPABASE_SERVICE_KEY= # R workers + n8n access to the pipeline project
PIPELINE_DATABASE_URL=        # R  pipeline Postgres URL for make db-migrate

# --- Shopify (Strong Years store's "Strong Years Offers" app) -------------------------------------------
SHOPIFY_WEBHOOK_SECRET=       # L  the app's Client secret: verifies webhook HMACs
SHOPIFY_ADMIN_TOKEN=          # L  Admin API token: refunds, seat ledger (read/write orders, inventory, products)
SHOPIFY_STORE=                # L  xxx.myshopify.com: webhook self-heal cron (shopify/scripts/webhooks-heal.ts)
CONFIRM_STORE=                # L  same value as SHOPIFY_STORE (live-run guard)
MEMBERS_APP_URL=              # L  https://members.strongyears.com: webhook target

# --- Anthropic ----------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=            # L  members chat + the mandatory compliance judge (without it everything routes to a human)

# --- Email (Resend or Postmark) -----------------------------------------------------------------------
RESEND_API_KEY=               # L  transactional + lifecycle email (or POSTMARK_SERVER_TOKEN)
POSTMARK_SERVER_TOKEN=        # O  alternative to Resend

# --- Meta ---------------------------------------------------------------------------------------------
META_APP_SECRET=              # L  verifies X-Hub-Signature-256 on DM webhooks
META_CAPI_TOKEN=              # O  server-side conversions (consented users only)
# Page access tokens for the DM bot live in the vault as META_PAGE_TOKEN_<PAGE_ID>, one per Page / IG account.

# --- Generation (content pipeline) --------------------------------------------------------------------
GEMINI_API_KEY=               # O  reference pack + keyframes (production/refs/render_refs.py, DRY_RUN default)
ELEVENLABS_API_KEY=           # O  voice design + TTS
FAL_KEY=                      # O  keyframe / video queue (n8n)
WAVESPEED_API_KEY=            # O  InfiniteTalk lip-sync (n8n)

# --- Storage (Cloudflare R2) --------------------------------------------------------------------------
R2_ACCESS_KEY_ID=             # O  rendered media bucket
R2_SECRET_ACCESS_KEY=         # O  rendered media bucket

# --- Upstash (rate limits on serverless) --------------------------------------------------------------
RATE_LIMIT_KV_TOKEN=          # L  members app rate limiting across instances

# --- Slack --------------------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=            # O  n8n alerts (approve video, QA failed, pipeline error)
ONCALL_SLACK_WEBHOOK_URL=     # L  crisis and on-call alerts from the members app

# --- Twilio (off until 10DLC / toll-free approval) ----------------------------------------------------
TWILIO_AUTH_TOKEN=            # O  SMS; consumer texts stay "skipped" until SMS_ENABLED=true

# --- C2PA signing certificate (from a CA on the C2PA trust list) --------------------------------------
C2PA_PRIVATE_KEY=             # O  path or PEM; without it masters are unsigned and held for review

# --- Hetzner (only on the operator's laptop, never on the server) -------------------------------------
HCLOUD_TOKEN=                 # O  hcloud CLI to create the server with deploy/cloud-init.yaml
