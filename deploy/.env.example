# Copy to deploy/.env (never commit it). Values marked CHANGE must be set; secrets come from the vault (see secrets.example.env).
DOMAIN=strongyears.com                 # CHANGE: n8n.<DOMAIN> and workers.<DOMAIN> get TLS from Caddy
ACME_EMAIL=ops@strongyears.com         # CHANGE: Let's Encrypt notices
N8N_VERSION=1.112.0
LAUNCH_MODE=prelaunch                  # prelaunch until D0; "live" enables the publishing nodes on the next make n8n-import
SITE_BASE_URL=https://strongyears.com
APP_URL=https://members.strongyears.com
ASSEMBLY_CPUS=6
X264_PRESET=medium
# Switches that stay off until a person turns them on:
SPEND_ENABLED=0
GROWTH_DRY_RUN=1
GROWTH_LIVE_METRICS=0
DM_SEND_ENABLED=0
REVIEWER_SIGNED=0
