# Copy to .env (never commit). npm run provision reads process.env (use: set -a; . ./.env; set +a).
DRY_RUN=true
SHOPIFY_STORE=strong-years.myshopify.com
CONFIRM_STORE=strong-years.myshopify.com
# Dev Dashboard app (same organization as the store) → Settings → Credentials:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or a pre-existing Admin API token instead of the two above:
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
SUBSCRIPTION_ENGINE=shopify_subscriptions
MEMBERS_APP_URL=https://members.strongyears.com
SY_DOMAIN=strongyears.com
COMPANY_LEGAL_NAME=
MAILING_ADDRESS=
SUPPORT_EMAIL=help@strongyears.com
BILLING_PHONE=
GOVERNING_STATE=
FOUNDING_CLOSE_DATE=2027-01-09
KIT_SHIP_DAYS=2 business days
SMS_ENABLED=false
REVIEWER_SIGNED=false
LEGAL_EFFECTIVE_DATE=
