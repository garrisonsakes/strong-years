// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`provisioning plan (DRY_RUN snapshot) > close-founding is one-way and needs explicit confirmation 1`] = `
[
  "query    ShopContext                Read shop context (currency, location, Online Store publication)",
  "query    ProductByHandle            Read founding product",
  "query    ProductByHandle            Read standard product",
  "mutation VariantInventoryPolicy     Founding variant: inventoryPolicy CONTINUE so renewals never fail",
  "mutation UnpublishFromOnlineStore   Unpublish founding product from Online Store (existing contracts keep billing)",
  "mutation ProductUpdate              Activate standard membership",
  "mutation PublishToOnlineStore       Publish standard membership",
  "mutation MetafieldsSet              Mark founding group closed (theme switches every CTA to standard)",
]
`;

