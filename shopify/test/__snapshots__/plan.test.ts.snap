  "query    DiscountByCode             Find discount STARTER12",
  "mutation DiscountCodeCreate         Create discount STARTER12 (cell-B)",
  "query    DiscountByCode             Find discount STARTER12S",
  "mutation DiscountCodeCreate         Create discount STARTER12S (cell-B)",
