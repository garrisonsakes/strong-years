{%- assign cells = shop.metafields.strong_years.cells.value -%}
{%- assign f = shop.metafields.strong_years.founding.value -%}
{%- assign founding = all_products['founding-membership'] -%}
<section class="wrap stack-s section" aria-labelledby="h-{{ section.id }}">
  <h2 id="h-{{ section.id }}">{{ section.settings.heading }}</h2>
  <div class="stack-s" data-arm-only="A">
    <a class="btn" data-sy-ebook-link href="/products/strong-years-starter-books">Get both books for&nbsp;{%- for c in cells.ebook -%}<span data-cell-only="{{ c.id }}">${{ c.price | remove: '.00' }}</span>{%- endfor -%}</a>
    <p class="under">One payment. Nothing renews.</p>
  </div>
  <div class="stack-s" data-arm-only="T">
    {%- if f.closed or founding.available == false -%}
      <a class="btn" href="/products/strong-years-membership?view=trial">Start my 7-day trial: $12 today</a>
      <p class="under">The founding group is full. $12 today for the Starter Books and a 7-day trial; then the standard price monthly until you cancel.</p>
    {%- else -%}
      <a class="btn" href="/products/founding-membership?view=trial">Start my 7-day trial: $12 today</a>
      <p class="under">$12 today for the Starter Books and a 7-day trial of the membership. First $25 on day 7, then $25 a month until you cancel. Cancel online anytime.</p>
    {%- endif -%}
  </div>
  <div class="stack-s" data-arm-only="B">
    {%- if f.closed or founding.available == false -%}
      <a class="btn" href="/products/strong-years-membership">Join Strong Years</a>
    {%- else -%}
      <a class="btn" href="/products/founding-membership?view=starter">Start for $12 today</a>
      <p class="under">Then $25 a month until you cancel. Cancel online anytime.</p>
    {%- endif -%}
  </div>
  <p class="small">Giving it to a parent? <a href="/products/gift-strong-years">Prepaid gift memberships</a> never renew.</p>
</section>
{% schema %}
{
  "name": "Final call to action",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Your first session takes 8 minutes." }],
  "presets": [{ "name": "Final call to action" }]
}
{% endschema %}
