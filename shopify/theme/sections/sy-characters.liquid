<section class="wrap stack section" aria-labelledby="h-{{ section.id }}">
  <h2 id="h-{{ section.id }}">{{ section.settings.heading }}</h2>
  <div class="pair">
    {% render 'sy-character', who: 'chang', size: 110, text: '<p><strong>Chang Yin</strong>, 74, a retired welder who trains in his California garage every morning. "Measure twice. Lift once."</p>' %}
    {% render 'sy-character', who: 'sun', size: 110, text: '<p><strong>Sun Yoon</strong>, 76, his wife. Honest to a fault. She will tell you your breakfast is too small.</p>' %}
  </div>
  <div class="card"><p>Chang Yin and Sun Yoon are AI characters, and their life story is made up. They are not real people, not doctors, and not religious teachers. The practices and recipes are real. Each one is built from published guidelines for older adults. <a href="/pages/about-the-characters">More about the characters</a></p></div>
</section>
{% schema %}
{
  "name": "Meet the characters",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Meet the two of them." }],
  "presets": [{ "name": "Meet the characters" }]
}
{% endschema %}
