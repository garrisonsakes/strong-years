{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000"
  },
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/.next/**)",
      "Read(./**/coverage/**)",
      "Read(./**/package-lock.json)",
      "Read(./**/*.tsbuildinfo)",
      "Read(./**/*.pdf)",
      "Read(./**/*.mp4)",
      "Read(./**/*.mov)",
      "Read(./**/*.wav)",
      "Read(./products/_build/**)"
    ]
  }
}
