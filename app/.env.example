# ---------------------------------------------------------------------------
# Strong Years — environment variables. Copy to .env.local for local dev.
# EVERY integration is optional: leave a block empty and that part runs as a
# local stub (in-memory data, checkout simulator, scripted coach replies,
# messages written to the outbox table). Never commit real keys.
# ---------------------------------------------------------------------------

# Public base URL (no trailing slash). Used in emails, Stripe redirects, CAPI.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production. Long random strings (openssl rand -hex 32).
SESSION_SECRET=
CRON_SECRET=
# Required on every real deploy (no default); only a local in-memory demo uses admin / strongyears-demo.
ADMIN_USER=
ADMIN_PASSWORD=
# Optional second factor for /admin (base32, from any authenticator app). When set,
# type the password followed by the current 6-digit code in the password box.
ADMIN_TOTP_SECRET=
# Client IP for rate limits and the admin lockout comes only from trusted proxy headers.
# On Vercel nothing to set (x-real-ip). Elsewhere set ONE of these, or proxy headers are ignored:
#   TRUSTED_PROXY_HOPS=1          number of proxies in front of the app (uses the Nth X-Forwarded-For entry from the right)
#   TRUSTED_PROXIES=10.0.0.1,...  your proxies' addresses (skipped from the right of X-Forwarded-For)
#   CLIENT_IP_HEADER=...          a header your edge sets and overwrites (e.g. true-client-ip)
#   TRUST_CLOUDFLARE=true         behind Cloudflare: cf-connecting-ip
# Detected automatically: Vercel, Fly (fly-client-ip), Netlify, Render / Railway / Heroku / Cloud Run (one hop).
TRUSTED_PROXY_HOPS=
TRUSTED_PROXIES=
CLIENT_IP_HEADER=
TRUST_CLOUDFLARE=

# ---- Supabase (absent => in-memory demo store, seeded with is_demo rows) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe, TEST MODE (absent => built-in checkout simulator) ----
STRIPE_SECRET_KEY=              # sk_test_... (blank = simulator)
STRIPE_WEBHOOK_SECRET=          # whsec_... REQUIRED: without it every webhook is refused (500)
DEV_ALLOW_UNSIGNED=false        # local dev only: accept unsigned webhook JSON. Ignored on Vercel production and with live keys
# Live keys are refused unless this is "true". Leave false until launch day.
ALLOW_LIVE_STRIPE=false
# Price IDs (test mode). Any that are blank fall back to inline price_data.
STRIPE_PRICE_MONTHLY=          # $20/mo recurring (arm A after trial)
STRIPE_PRICE_FOUNDING=         # $20/mo recurring, founding (grandfathered) price
STRIPE_PRICE_ESSENTIALS=       # $12/mo recurring (cancel-flow downgrade)
STRIPE_PRICE_ANNUAL=           # $119/yr recurring (member campaigns, not first checkout)
STRIPE_PRICE_PARTNER=          # $8/mo recurring (REQUIRED to sell partner seats with real Stripe)
STRIPE_PRICE_TRIAL_FEE=        # $1 one-time
STRIPE_PRICE_RESET=            # $7 one-time
STRIPE_PRICE_KITCHEN=          # $17 one-time
STRIPE_PRICE_BUMP=             # $9 one-time
STRIPE_PRICE_PROGRAM=          # $27 one-time (upsell, charged off-session)
STRIPE_PRICE_KIT=              # $29 one-time (upsell)
STRIPE_PRICE_PRINTABLES=       # $7 one-time (downsell)
STRIPE_PRICE_GIFT3=            # $49 one-time
STRIPE_PRICE_GIFT12=           # $119 one-time
STRIPE_PORTAL_CONFIGURATION=   # optional bpc_... Customer Portal config id

# ---- Pricing & split test ----
PRICE_MONTHLY_CENTS=2000       # test cells: 1500 / 2000 / 2500 / 3000
PRICE_FOUNDING_CENTS=2000
FOUNDING_COHORT_CAP=5000       # real cap, publicly counted
ARM_B_SHARE=0.5                # share of visitors in arm B (founding, charge today); the rest see the $1 trial. Sticky per signed visitor id, logged as p2500/p3000/trial2500
DISPLAY_TZ=America/Los_Angeles

# ---- Anthropic (absent => scripted character replies; safety layer still runs) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Email: Resend OR Postmark (absent => outbox stub) ----
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=hello@strongyears.com

# ---- SMS: Twilio 10DLC (absent => outbox stub) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=            # +1..., or a Messaging Service SID (MG...)

# ---- On-call human for crisis events & "talk to a human" ----
ONCALL_EMAIL=
ONCALL_PHONE=
ONCALL_SLACK_WEBHOOK_URL=
ONCALL_HOURS=07:00-23:00        # when a person is on duty ("24/7" once covered); the chat says so honestly outside these hours
ONCALL_TZ=America/New_York     # canon: 7:00-23:00 Eastern, 7 days

# ---- Meta Conversions API (absent => events stored locally only) ----
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ---- Compliance copy ----
# Stays false until a licensed reviewer has SIGNED; then set names too.
REVIEWER_SIGNED=false
REVIEWER_PT_NAME=
REVIEWER_RD_NAME=
SUPPORT_EMAIL=help@strongyears.com
# Required on every real deploy, with NEXT_PUBLIC_SITE_URL (https, not localhost), EMAIL_FROM and
# SUPPORT_EMAIL: with any of them missing or a placeholder, email is refused and /api/health returns 503.
MAILING_ADDRESS=
FRIENDSHIP_LINE_NUMBER=        # verify before launch (FUNNEL.md 4.14); blank = not shown

# ---- BLITZ CANON (default). OFFER_MODE=standard restores the OFFER.md $1-trial funnel ----
OFFER_MODE=blitz
BLITZ_PRICE_TEST=true          # sticky 50/50 by visitor (sy_vid cookie), logged per cell
BLITZ_PRICE_CELLS=2500,3000
BLITZ_DEFAULT_PRICE_CENTS=2500 # shown to everyone when the test is off
STANDARD_PRICE_CENTS=3500      # price for new members once the founding cap is reached
TRIAL_ARM_ENABLED=true         # both arms run from day 1 (founding vs $1 trial)
BLITZ_TRIAL_PRICE_CENTS=2500   # what the $1 trial renews at (founding test price; standard price after the cap)
FRONTEND_PAGES_ENABLED=false   # standalone /reset and /kitchen (in blitz they are bumps on /join)
# Optional Stripe price IDs per founding cell: STRIPE_PRICE_FOUNDING_2500 / _3000, STRIPE_PRICE_STANDARD

# ---- SMS: off until 10DLC / toll-free approval; reminders go by email until then ----
SMS_ENABLED=false

# ---- Payment processors: Stripe primary, Braintree adapter stubbed ----
PROCESSOR_ROUTING=failover     # failover | split
PROCESSOR_SPLIT_BRAINTREE=0    # share of checkouts to Braintree when routing=split
BRAINTREE_ENABLED=false        # true without credentials = test simulator, only when STRIPE_SECRET_KEY is unset and never in production
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
STRIPE_MONTHLY_CAP_CENTS=0     # rolling 30-day volume guard per processor (0 = none)
BRAINTREE_MONTHLY_CAP_CENTS=0

# ---- Audit fixes (Sep 30 2026) -----------------------------------------------
# Rate limits are per server instance by default. For multi-instance hosting,
# point these at an Upstash Redis REST endpoint so limits are shared.
# Recommended for any multi-instance deploy (Vercel/serverless, autoscaling): Upstash Redis REST.
# Without it each instance counts on its own.
RATE_LIMIT_KV_URL=
RATE_LIMIT_KV_TOKEN=
# Shown on the (draft) policy pages.
LEGAL_ENTITY_NAME=
PRIVACY_EMAIL=
# Test builds only: lets `next start` serve the built-in checkout simulator (e2e, screenshots).
ALLOW_MOCK_CHECKOUT_IN_PROD_BUILD=false
# Marks a local in-memory demo build (the e2e and screenshot servers under `next start`).
# Ignored on Vercel production and whenever Supabase is configured. Anything else with
# NODE_ENV other than development/test is a real deploy: the chat needs ANTHROPIC_API_KEY
# (otherwise it goes offline with 988 / 911 / Eldercare Locator), email needs the config
# above, and ADMIN_USER / ADMIN_PASSWORD have no defaults. (Old name: ALLOW_RULES_ONLY_CHAT.)
LOCAL_DEMO_BUILD=false
# Web push reminders (retention nudge until SMS is approved). Generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:help@strongyears.example
# Billing phone line shown in policies (nobody ever needs to call to cancel).
BILLING_PHONE=

# ---------------------------------------------------------------------------
# Round 10 (CANON UPDATE 2): Shopify commerce, organic-first launch, attribution
# ---------------------------------------------------------------------------
# shopify (default, the launch path) | stripe (original in-app checkout, kept behind the adapter)
BILLING_PROVIDER=shopify
# Bare host of the store (cart permalinks + webhook shop check), e.g. strongyears.myshopify.com
SHOPIFY_STORE_DOMAIN=
# The app's webhook signing secret (Settings → Notifications → Webhooks, or the custom app's API secret).
# Required: without it /api/webhooks/shopify answers 503 and processes nothing.
SHOPIFY_WEBHOOK_SECRET=
# Admin API access token of the Strong Years Offers app (scopes: read_orders, write_orders, read_customers,
# read_inventory). Used only for the 14-day self-serve refund (refundCreate). Contract cancel/edit mutations need
# write_own_subscription_contracts and work only on contracts OUR app owns (SUBSCRIPTION_ENGINE=app); on the launch
# path a person cancels the contract in Apps → Subscriptions. Unset on a deploy = refunds go to a person.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Customer account page where Shopify Subscriptions lets members cancel / pause / change card / upgrade to yearly
SHOPIFY_CUSTOMER_ACCOUNT_URL=
# Days of access after a failed renewal before the members area closes (default 7)
SHOPIFY_GRACE_DAYS=7
# Round 5 audit: the numeric Location id that holds the founding variant's stock. The seat ledger (renewal orders and
# refunded first charges give the founding seat back with inventoryAdjustQuantities, needs write_inventory; stock 0 →
# productVariantsBulkUpdate inventoryPolicy CONTINUE, needs write_products) uses the inventory mirror's location when
# an inventory_levels/update has arrived, else this. Unset and no mirror → a ticket instead of an adjustment.
SHOPIFY_LOCATION_ID=
# Front-end cells (rows in shopify_products.cell), sticky per signed visitor id. CANON UPDATE 3: m12 = "$12 today = books +
# first month, then $25/mo" is the LAUNCH DEFAULT; e12 = books only (founding offer on the thank-you page + 3 emails) is the
# test cell; e7 / e15 are catalog rows for a later price test. FRONT_END_CELL_TEST=false shows everyone the default cell.
FRONT_END_CELLS=m12,e12
FRONT_END_DEFAULT_CELL=m12
FRONT_END_CELL_TEST=true
# Who owns the subscription contracts: shopify_subscriptions (launch default; the free app bills, we cannot cancel/edit
# contracts or receive contract webhooks) | app (our app created the selling plans and runs billing; not built for launch)
SUBSCRIPTION_ENGINE=shopify_subscriptions
# FOUNDING_COHORT_CAP (above) must equal the founding plan variant's Shopify inventory.
# Optional: shown on /waitlist ("Open to the first 5,000 members or until <date>")
FOUNDING_CLOSE_DATE=

# Launch mode: prelaunch (default; every checkout path refuses on the server, /join → /waitlist) | live
LAUNCH_MODE=prelaunch
# The real opening moment (ISO with zone). The only thing the waitlist ever counts down to; checkout opens by itself then.
CHECKOUT_OPENS_AT=
# Bot timing check on the waitlist form (ms the form must be open; default 3000)
WAITLIST_MIN_FILL_MS=3000

# Growth engine (service only): GET /api/growth/posts with Authorization: Bearer <token>. Unset/short = endpoint off (404).
GROWTH_API_TOKEN=

# Server-side conversion events (only with ad-measurement consent; hashed email only). Unset = disabled, no network.
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Local e2e only (refused on any deploy): append every email, unredacted, to <dir>/mail.jsonl
# DEV_MAIL_SINK_DIR=test-results/mail-sink
